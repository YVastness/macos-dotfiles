"isMovie":0,"number":22,"seasonNumber":1,"lastUpdated":"2026-02-18 16:19:19","characters":[]},{"id":10057071,"seriesId":424536,"name":"攻略迷宫","aired":"2024-02-16","runtime":25,"image":"/banners/v4/episode/10057071/screencap/65cb96020dbab.jpg","imageType":11,"isMovie":0,"number":23,"seasonNumber":1,"lastUpdated":"2026-02-18 16:46:34","characters":[]},{"id":10057072,"seriesId":424536,"name":"完美的复制体","aired":"2024-02-23","runtime":25,"image":"/banners/v4/episode/10057072/screencap/65d4bfcc5a74c.jpg","imageType":11,"isMovie":0,"number":24,"seasonNumber":1,"lastUpdated":"2026-02-18 16:46:56","characters":[]},{"id":10057073,"seriesId":424536,"name":"致命破绽","aired":"2024-03-01","runtime":25,"image":"/banners/v4/episode/10057073/screencap/65ddf33f9c6ae.jpg","imageType":11,"isMovie":0,"number":25,"seasonNumber":1,"lastUpdated":"2026-02-18 16:47:21","characters":[]},{"id":10086091,"seriesId":424536,"name":"魔法的高深之处","aired":"2024-03-08","runtime":25,"image":"/banners/v4/episode/10086091/screencap/65e750eb8cbe8.jpg","imageType":11,"isMovie":0,"number":26,"seasonNumber":1,"lastUpdated":"2026-02-18 16:47:50","characters":[]},{"id":10086092,"seriesId":424536,"name":"人类的时代","aired":"2024-03-15","runtime":25,"image":"/banners/v4/episode/10086092/screencap/65f468dd5a039.jpg","imageType":11,"isMovie":0,"number":27,"seasonNumber":1,"lastUpdated":"2026-02-18 16:16:40","characters":[]},{"id":10086093,"seriesId":424536,"name":"因为下次再见时会很难为情","aired":"2024-03-22","runtime":24,"image":"/banners/v4/episode/10086093/screencap/65f95e7dcf03d.jpg","imageType":11,"isMovie":0,"number":28,"seasonNumber":1,"lastUpdated":"2026-02-18 16:49:03","finaleType":"season","characters":[]},{"id":10719109,"seriesId":424536,"name":"那，走吧","aired":"2026-01-16","runtime":24,"overview":"离开魔法都市维萨斯特后，芙莉莲、菲伦与休塔尔克踏上了前往北方诸国的旅途。行进途中，他们因地面塌陷坠入洞穴。此处遍布着能无效化魔力的“封魔矿”。当芙莉莲与菲伦皆无法使用魔法，只能摸索通往地面的出路时——魔物悄然现出了身影……","image":"/banners/v4/episode/10719109/screencap/6966236a8a113.jpg","imageType":11,"isMovie":0,"number":1,"seasonNumber":2,"lastUpdated":"2026-01-22 12:25:33","characters":[]},{"id":11447765,"seriesId":424536,"name":"南方的勇者","aired":"2026-01-23","runtime":24,"overview":"芙莉莲一行人在北方诸国的村子里接到了擦拭勇者像的委托。那尊雕像并非辛美尔，而是曾被誉为人类最强的“南方的勇者”的雕像。芙莉莲回想起了与“南方的勇者”相遇时的情景……随后，来到达哈伯爵领地的城镇时，芙莉莲一行又从领主那里接到了“希望从魔族手中夺回宝剑”的请求……","image":"/banners/v4/episode/11447765/screencap/696f60a4eb1b0.jpg","imageType":11,"isMovie":0,"number":2,"seasonNumber":2,"lastUpdated":"2026-01-26 07:42:26","characters":[]},{"id":11447766,"seriesId":424536,"name":"喜欢的地方","aired":"2026-01-30","runtime":24,"overview":"在温泉胜地埃托维斯，芙莉莲一行人对温泉满怀期待，然而那座村庄却早已荒废。听说深山中有着“埃托维斯山的秘密温泉”，三人决定前往一探究竟。在险峻且栖息着魔物的山道前方，等待着他们的究竟是……随后，在抵达下一座城市时，菲伦收到了来自休塔尔克的意外邀约。","image":"/banners/v4/episode/11447766/screencap/69789ca997b6e.jpg","imageType":11,"isMovie":0,"number":3,"seasonNumber":2,"lastUpdated":"2026-01-30 19:21:06","characters":[]},{"id":11447767,"seriesId":424536,"name":"他人的故乡","aired":"2026-02-06","runtime":24,"overview":"休塔尔克本是抱着捉弄的心态发出的邀请，结果真的变成了两人去约会。游览了城里各处的两人，最终来到了观景广场。在那里，菲伦说出了……几天后，三人离开了城市，踏入了环境严酷的北部高原。途经一个村落时，他们听说附近出现了强大的魔物……","image":"/banners/v4/episode/11447767/screencap/6981cbe484ace.jpg","imageType":11,"isMovie":0,"number":4,"seasonNumber":2,"lastUpdated":"2026-02-08 16:47:49","characters":[]},{"id":11447768,"seriesId":424536,"name":"北部高原的物流","aired":"2026-02-13","runtime":24,"overview":"在某个酒吧小镇，芙莉莲与矮人法斯重逢。他极为嗜酒，两百多年来一直在寻找皇帝酒“博斯哈夫特”，声称那酒就沉睡在他亲自挖掘的坑道尽头，到底能不能找到呢……而在他们随后到访的诺尔姆商会领地，竟然发现芙莉莲从80年前就背负着一笔巨额债务……","image":"/banners/v4/episode/11447768/screencap/698b19040caea.jpg","imageType":11,"isMovie":0,"number":5,"seasonNumber":2,"lastUpdated":"2026-02-15 09:51:13","characters":[]},{"id":11447769,"seriesId":424536,"name":"讨伐委托","aired":"2026-02-27","runtime":24,"overview":"在北部高原的一个村庄，接受了赛丽艾讨伐魔族委托的一级魔法使盖纳乌和梅特黛出现在那里。据说那个村庄是盖纳乌的故乡……随后，同样接到讨伐委托的菲伦一行人也来到了这里。村庄已经惨遭全灭，从牺牲者身上特征明显的伤痕中，某个魔族的身影若隐若现。","image":"/banners/v4/episode/11447769/screencap/699d8cf5b1b0b.jpg","imageType":11,"isMovie":0,"number":6,"seasonNumber":2,"lastUpdated":"2026-02-27 16:32:15","characters":[]},{"id":11447770,"seriesId":424536,"aired":"2026-03-06","runtime":24,"isMovie":0,"number":7,"seasonNumber":2,"lastUpdated":"2026-02-27 15:36:38","characters":[]},{"id":11447771,"seriesId":424536,"aired":"2026-03-13","runtime":24,"isMovie":0,"number":8,"seasonNumber":2,"lastUpdated":"2026-02-13 15:30:37","characters":[]},{"id":11447772,"seriesId":424536,"aired":"2026-03-20","runtime":24,"isMovie":0,"number":9,"seasonNumber":2,"lastUpdated":"2026-02-13 15:30:51","characters":[]},{"id":11447773,"seriesId":424536,"aired":"2026-03-27","runtime":24,"isMovie":0,"number":10,"seasonNumber":2,"lastUpdated":"2026-02-13 15:31:08","finaleType":"season","characters":[]}]}
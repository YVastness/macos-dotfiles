/thetvdb.com/people/8107758-bao-jian-feng","peopleType":"Actor","personName":"Bao Jianfeng"},{"id":69470933,"name":"Zhao Hong Yin","peopleId":8170885,"seriesId":473013,"type":3,"sort":8,"isFeatured":true,"url":"https://thetvdb.com/people/8170885-hao-ping","peopleType":"Actor","personName":"Hao Ping"}],"airsDays":{"sunday":true,"monday":true,"tuesday":true,"wednesday":true,"thursday":true,"friday":true,"saturday":true},"airsTime":"21:00","seasons":[{"id":2228923,"seriesId":473013,"type":{"id":1,"name":"Aired Order","type":"official"},"number":0,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]},{"id":2228924,"seriesId":473013,"type":{"id":1,"name":"Aired Order","type":"official"},"number":1,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]},{"id":2228925,"seriesId":473013,"type":{"id":3,"name":"Absolute Order","type":"absolute"},"number":1,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]}],"translations":{"nameTranslations":[{"name":"太平年","language":"zho","IsPrimary":true},{"name":"Swords into Plowshares","language":"eng","IsPrimary":false},{"name":"Swords into Ploughshares","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Tai Ping Nian","isAlias":"true","language":"eng","IsPrimary":false},{"name":"The Age of Peace","isAlias":"true","language":"eng","IsPrimary":false}],"overviewTranslations":[{"overview":"公元941年，吴越国王钱元瓘离世，新主少年继位，吴越王室陷入内外交困。五年后，王弟钱弘俶（白宇 饰）自请随使臣北上汴梁朝贺正旦，然而汴梁的局面竟是契丹兵临城下，天子石重贵称臣契丹，宰相冯道在风雨飘摇中权衡各方。此行，钱弘俶经历了北方家国破碎、人伦失序的惨淡，在危难中与郭荣（俞灏明 饰）和赵匡胤（朱亚文 饰）结下深厚的情谊。回到吴越国，钱弘俶一改往日自由散漫的个性，在朝廷大展拳脚，内除奸臣、外打豪强，又于政权动乱之时扛起国主的重任。另一方面，北方的赵匡胤，继承了郭荣未竟的事业，建立北宋政权，兴兵南下。最终，在北宋统一的大势和天下黎庶的福祉面前，赵匡胤、钱弘俶摒弃兵戈，于太平兴国三年（公元978年）完成了“纳土归宋”和平统一的历史创举。 ","language":"zho","IsPrimary":true},{"overview":"Set during the turbulent Five Dynasties and Ten Kingdoms period, the drama draws inspiration from a major historical turning point over a thousand years ago. Amid war, political collapse, and widespread suffering, Qian Hong Chu, Zhao Kuang Yin, and Guo Rong are three driven young men whose experiences gradually lead them to question the cost of division and the meaning of stability.  As shifting powers reshape the era, Qian Hong Chu takes on the burden of ruling Wuyue and protecting his people, while Zhao Kuang Yin carries forward an unfinished vision born of chaos, seeking order through discipline and reform. Their journeys reflect a growing belief in unity, peace, and the hope for a more stable world beyond endless conflict.","language":"eng","IsPrimary":false}],"aliases":"[Swords into Ploughshares,Tai Ping Nian,The Age of Peace]"},"tags":[{"id":4514,"tag":1,"tagName":"Sub-Genre","name":"C-Drama","helpText":"Chinese Drama"},{"id":21,"tag":1,"tagName":"Sub-Genre","name":"Period"},{"id":63,"tag":3,"tagName":"TV Type or Format","name":"Story-based Drama","helpText":"Drama series where you must watch all episodes in order. Ex: Game of Thrones, The Walking Dead, Killing Eve"},{"id":184,"tag":31,"tagName":"Geographic Location","name":"Asia"}],"contentRatings":[],"seasonTypes":[{"id":1,"name":"Aired Order","type":"official"},{"id":3,"name":"Absolute Order","type":"absolute"}]}
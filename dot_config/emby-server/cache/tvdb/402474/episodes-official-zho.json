ap/697372efc0859.jpg","imageType":11,"isMovie":0,"number":3,"seasonNumber":2,"lastUpdated":"2026-02-08 21:26:01","characters":[]},{"id":11522445,"seriesId":402474,"name":"士道与修罗","aired":"2026-02-01","runtime":24,"overview":"殊现一行人前往神仙乡。佐切深信殊现会伸出援手，但士远对他的看法却大不相同。","image":"/banners/v4/episode/11522445/screencap/697caabf7cd28.jpg","imageType":11,"isMovie":0,"number":4,"seasonNumber":2,"lastUpdated":"2026-02-27 11:43:42","characters":[]},{"id":11522446,"seriesId":402474,"name":"人与仙人","aired":"2026-02-08","runtime":24,"overview":"大家分成两队，一队出发寻找仙药，另一队负责研拟逃生路线。画眉丸问梅她是否真的想离开这座岛屿","image":"/banners/v4/episode/11522446/screencap/6987308f30a79.jpg","imageType":11,"isMovie":0,"number":5,"seasonNumber":2,"lastUpdated":"2026-02-08 21:26:37","characters":[]},{"id":11522447,"seriesId":402474,"aired":"2026-02-15","runtime":24,"image":"/banners/v4/episode/11522447/screencap/698f5d4a6204a.jpg","imageType":11,"isMovie":0,"number":6,"seasonNumber":2,"lastUpdated":"2026-03-01 16:28:03","characters":[]},{"id":11522448,"seriesId":402474,"aired":"2026-02-22","runtime":24,"image":"/banners/v4/episode/11522448/screencap/699858d065f91.jpg","imageType":11,"isMovie":0,"number":7,"seasonNumber":2,"lastUpdated":"2026-02-27 17:50:09","characters":[]},{"id":11522449,"seriesId":402474,"aired":"2026-03-01","runtime":24,"image":"/banners/v4/episode/11522449/screencap/69a3a835325ee.jpg","imageType":11,"isMovie":0,"number":8,"seasonNumber":2,"lastUpdated":"2026-03-01 15:55:13","characters":[]},{"id":11522450,"seriesId":402474,"aired":"2026-03-08","runtime":24,"isMovie":0,"number":9,"seasonNumber":2,"lastUpdated":"2026-02-18 12:26:03","characters":[]},{"id":11522451,"seriesId":402474,"aired":"2026-03-15","runtime":24,"isMovie":0,"number":10,"seasonNumber":2,"lastUpdated":"2025-12-24 18:50:38","characters":[]},{"id":11522452,"seriesId":402474,"aired":"2026-03-22","runtime":24,"isMovie":0,"number":11,"seasonNumber":2,"lastUpdated":"2025-12-24 18:50:40","characters":[]},{"id":11522453,"seriesId":402474,"aired
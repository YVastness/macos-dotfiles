{"id":0,"primaryCompanyType":0}]},{"id":2222854,"seriesId":452275,"type":{"id":1,"name":"Aired Order","type":"official"},"number":2,"nameTranslations":[],"overviewTranslations":["zho"],"image":"https://artworks.thetvdb.com/banners/v4/season/2222854/posters/69643d55746d0.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]}],"translations":{"nameTranslations":[{"name":"剑来","language":"zho","IsPrimary":true},{"name":"Sword Comes","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Sword Coming","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Sword of Coming","language":"eng","IsPrimary":false},{"name":"Ven, espada","isAlias":"true","language":"spa","IsPrimary":false},{"name":"La llegada de la espada","language":"spa","IsPrimary":false},{"name":"Явление меча","language":"rus","IsPrimary":false},{"name":"Меч грядущего","isAlias":"true","language":"rus","IsPrimary":false},{"name":"Kiếm Lai","language":"vie","IsPrimary":false},{"name":"Jian Lai","isAlias":"true","language":"zho","IsPrimary":false},{"name":"剑来","isAlias":"true","language":"zho","IsPrimary":false}],"overviewTranslations":[{"overview":"平凡少年一剑开天覆山海，逆袭绝代剑客，开创非凡传奇。","language":"zho","IsPrimary":true},{"overview":"A common young boy, with a single sword, splits the heavens and overturns mountains and seas, rising to become an unparalleled swordsman and creating an extraordinary legend.","language":"eng","IsPrimary":false},{"overview":"Un joven común, con una sola espada, divide los cielos y vuelca montañas y mares, ascendiendo a convertirse en un espadachín sin igual y creando una leyenda extraordinaria.","language":"spa","IsPrimary":false},{"overview":"История начинается с легенды, рассказанной стариком на площади маленькой деревушки, о великом бессмертном, который тысячи лет назад посвятил свою жизнь уничтожению драконов. Его ненависть к этим мифическим существам остается загадкой. Когда последний дракон был повержен, его энергия (ци) преобразовалась в сокровища, включая не только предметы, но и людей. Эта тайна привлекает внимание искателей приключений со всего мира. Главный герой, Чэнь Пин Янь, простой сельский парень, не подозревал, что его жизнь изменится, когда он продаст особую рыбу господину У, который верил в древнюю легенду о рыбах, способных стать драконами. Неожиданно Чэнь оказывается втянут в их приключения и постепенно раскрывает в себе скрытые силы. Его судьба сироты меняется, и он отправляется на поиски древних сокровищ. «Меч грядущего» — это аниме о силе легенд, мистических существах и превращениях, где каждый выбор может привести к новым открытиям и великим испытаниям.","language":"rus","IsPrimary":false},{"overview":"Trần Bình An từ một thiếu niên vô danh buộc phải gánh lấy sứ mệnh dẫn dắt Lý Bảo Bình cùng đồng hành vượt biên, tìm đường đến nước Tùy xa xôi để nối tiếp học nghiệp còn chưa hoàn thành. Hành trình mở ra giữa non sông rộng lớn, phong cảnh tuy đẹp như tranh, nhưng sát cơ ẩn sâu trong từng bước chân. Thiết kỵ lạnh lùng truy bức không ngừng, yêu tà quỷ mị rình rập trong bóng tối, sinh tử chỉ cách nhau một nhịp thở. Trước gió bụi mịt mờ ấy, Trần Bình An không còn đường lùi, chỉ có thể tiến lên, dùng ý chí và nắm đấm mở lối sinh tồn. Giữa cơn loạn thế, những cường giả giấu tên lần lượt xuất hiện, âm thầm dang tay che chở, cũng đồng thời đẩy chàng vào vòng xoáy sâu hơn của võ đạo và đại cục.","language":"vie","IsPrimary":false}],"aliases":"[Sword Comes,Sword Coming,Ven, espada,Меч грядущего,Jian Lai,剑来]"},"tags":[{"id":1,"tag":1,"tagName":"Sub-Genre","name":"Adaptation"},{"id":63,"tag":3,"tagName":"TV Type or Format","name":"Story-based Drama","helpText":"Drama series where you must watch all episodes in order. Ex: Game of Thrones, The Walking Dead, Killing Eve"},{"id":80,"tag":3,"tagName":"TV Type or Format","name":"Story-based Web Series","helpText":"Short-form series where you must watch all episodes in order.  \r\nThey are not streaming shows on platforms like Netflix, Prime Video, or Disney+. Ex: Dr. Horrible's Sing-Along Blog "},{"id":409,"tag":4,"tagName":"Time Period","name":"Antiquity / Ancient Times"}],"contentRatings":[],"seasonTypes":[{"id":1,"name":"Aired Order","type":"official"},{"id":3,"name":"Absolute Order","type":"absolute"}]}
y":false,"thursday":false,"friday":true,"saturday":false},"airsTime":"10:00","seasons":[{"id":671523,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":0,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]},{"id":671671,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":1,"nameTranslations":[],"overviewTranslations":["zho,eng,fra"],"image":"https://artworks.thetvdb.com/banners/series/313488/seasons/671671/posters/5efb1dccb29c0.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]},{"id":735488,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":2,"nameTranslations":[],"overviewTranslations":["fra,zho,eng"],"image":"https://artworks.thetvdb.com/banners/seasons/313488-2.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]},{"id":1832588,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":3,"nameTranslations":[],"overviewTranslations":["zho,eng,fra"],"image":"https://artworks.thetvdb.com/banners/series/313488/seasons/1832588/posters/5efb1df0e362d.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]},{"id":1898029,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":4,"nameTranslations":[],"overviewTranslations":["zho"],"image":"https://artworks.thetvdb.com/banners/v4/season/1898029/posters/6446149d1a11c.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]},{"id":2034067,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":5,"nameTranslations":[],"overviewTranslations":["zho,eng"],"image":"https://artworks.thetvdb.com/banners/v4/season/2034067/posters/644614304754f.jpg","imageType":7,"companies":[{"id":0,"primaryCompanyType":0}]},{"id":2221726,"seriesId":313488,"type":{"id":1,"name":"Aired Order","type":"official"},"number":6,"nameTranslations":[],"overviewTranslations":["eng"],"companies":[{"id":0,"primaryCompanyType":0}]},{"id":1676687,"seriesId":313488,"type":{"id":2,"name":"DVD Order","type":"dvd"},"number":0,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]},{"id":1676686,"seriesId":313488,"type":{"id":3,"name":"Absolute Order","type":"absolute"},"number":1,"nameTranslations":[],"overviewTranslations":[],"companies":[{"id":0,"primaryCompanyType":0}]}],"translations":{"nameTranslations":[{"name":"Hitori no Shita: The Outcast","language":"deu","IsPrimary":false},{"name":"Hitori No Shita: The Outcast","language":"eng","IsPrimary":false},{"name":"Hitori no Shita: The Outcast","language":"fra","IsPrimary":false},{"name":"一人之下","language":"jpn","IsPrimary":false},{"name":"일인지하 THE OUTCAST","language":"kor","IsPrimary":false},{"name":"Hitori no Shita: The Outcast","language":"por","IsPrimary":false},{"name":"Один из отвергнутых: Изгой","language":"rus","IsPrimary":false},{"name":"Hitori no Shita: The Outcast","language":"spa","IsPrimary":false},{"name":"一人之下","language":"zho","IsPrimary":true},{"name":"Hitori no Shita: The Outcast","language":"pt","IsPrimary":false},{"name":"Hitori no Shita: The Outcast","language":"ita","IsPrimary":false},{"name":"Yi Ren Zhi Xia","isAlias":"true","language":"zho","IsPrimary":false},{"name":"一人之下","language":"zhtw","IsPrimary":false},{"name":"一人之下 THE OUTCAST","isAlias":"true","language":"jpn","IsPrimary":false},{"name":"The Outcast","isAlias":"true","language":"ind","IsPrimary":false},{"name":"Hitori no Shita: The Outcast","language":"ind","IsPrimary":false},{"name":"King of the Weirdo","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Weirdo","isAlias":"true","language":"eng","IsPrimary":false},{"name":"The Weirdo","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Under One Person","isAlias":"true","language":"eng","IsPrimary":false},{"name":"Hitori no Shita","isAlias":"true","language":"eng","IsPrimary":false},{"name":"The Outcast (2016)","isAlias":"true","language":"eng","IsPrimary":false}],"overviewTranslations":[{"overview":"Als Cho Soran jedoch in das kleine Dorf seines Großvaters zurückkehrt, um dessen Grab zu besuchen, wird er in ein furchterregendes Ereignis verwickelt: Bei seinem nächtlichen Besuch auf dem Friedhof greifen ihn widerwärtige Zombies an! Er wird im letzten Moment von dem mysteriösen Mädchen Fuu Houhou gerettet. Diese völlig unerwartete und unglaubliche Begebenheit stellt das Leben und Schicksal unseres Helden dramatisch auf den Kopf.","language":"deu","IsPrimary":false},{"overview":"Chou Soran was a normal college student until he gets caught up in a terrible incident in a small village, while visiting his grandfather's grave, he then told by officer Song that he met a girl saying that she was the other daughter of his father. While walking through the graveyard, Soran is assaulted by zombies until a mysterious girl wielding a knife and a meat knife suddenly saves him. After encountering again with the girl Soran's life suddenly change, he was then force to join Houhou's company and many clan has come after him stating that he is the heir of Ketaigen style a power that was probably use by his late grandfather but Soran has no idea on what is going on with them.","language":"eng","IsPrimary":false},{"overview":"Zhang Chulan, un universitaire, est attaqué par des zombies dans un cimetière. En pleine attaque il sauve la vie d'une jeune fille en se servant du couteau qu'il tenait à la main. Il la revoit le lendemain dans la même université que la sienne. A partir de ce moment-là le destin de Chulan va commencer à changer.","language":"fra","IsPrimary":false},{"overview":"主人公・張楚嵐（チョウソラン）は、\r\nある日、墓場でゾンビに襲われる。\r\n\r\nその絶体絶命のピンチを救ったのは、一人の少女。\r\n手にした包丁で敵をなぎ倒してしまう。\r\n安堵する楚嵐に、\r\n少女は「この困難に自分で立ち向かえ」\r\nと意味ありげな言葉を残し、\r\n立ち去ってしまう。\r\n\r\n後日、大学に登校した張楚嵐の目の前に、\r\n再び少女は姿を現わす。\r\n\r\nその瞬間から、張楚嵐の数奇な運命が動き出していく。","language":"jpn","IsPrimary":false},{"overview":"주인공 장추란은 어느날 강시에 습격당한다.\r\n그 절체절명의 위기를 구한 것은 한 소녀.\r\n손에 든 부엌칼로 적을 쓰러뜨린 것을 보면서 안도하는 소란에, \r\n소녀는 \"이 혼란에 스스로 맞서라\"라는 말과 함께 그곳을 떴다.\r\n후일, 학교에 등교한 장추란의 앞에 그 소녀는 다시 나타났다.\r\n\r\n이 순간으로부터, 장추란의 기묘한 운명이 움직이기 시작한다.","language":"kor","IsPrimary":false},{"overview":"Cho Soran leva uma vida comum de um estudante universitário, até o dia em que se vê preso em um incidente terrível que aconteceu em uma pequena aldeia. Enquanto caminhava por um cemitério, ele é atacado por zumbis. Quando achava que tudo estava acabado, uma misteriosa garota portando uma espada surge e o salva, desaparecendo logo em seguida. Este estranho encontro vai mudar drasticamente o seu destino.","language":"por","IsPrimary":false},{"overview":"Обычный парень Соран Тё собрался проведать могилу дедушки и приехал в родную деревню… Но простая поездка закончилась крайне непросто. Кладбище осквернили! Странная девчонка! Лопата! Похороны! Зомби! Так перед нашим героем и открылся загадочный мир чужаков…","language":"rus","IsPrimary":false},{"overview":"Chou Soran era un estudiante universitario normal hasta que se ve atrapado en un terrible incidente en una pequeña aldea, mientras visitaba la tumba de su abuelo, y luego le dijo por el oficial Song que conoció a una chica diciendo que ella era la otra hija de su padre. Mientras camina por el cementerio, Soran es asaltado por zombis hasta que una chica misteriosa empuña un cuchillo y un cuchillo de carne lo salva de repente. Después de encontrarse de nuevo con la chica, la vida de Soran cambió repentinamente, luego se forzó a unirse a la compañía de Houhou y muchos clanes lo persuadieron de que era el heredero del estilo Ketaigen, un poder que probablemente fue utilizado por su difunto abuelo, pero Soran no tiene idea en lo que está pasando con ellos.","language":"spa","IsPrimary":false},{"overview":"這個世界是存在異人的。 張楚嵐就是一個隱藏在普通人中的異人。在生命的前19年中，他一直小心隱藏着自己和別人的不同。直到有一天，神秘少女馮寶寶找上了他。從此他被活屍追，被怪人砍，被捲入了前所未見的麻煩之中……","language":"zho","IsPrimary":true},{"overview":"Cho Soran, o protagonista, leva uma pacata vida de estudante colegial, até se meter num terrível incidente em uma pequena vila. Ao caminhar por um cemitério, Cho Soran é atacado por zumbis. Quando tudo já lhe parecia perdido, uma misteriosa garota munida de uma espada o salva e desaparece.","language":"pt","IsPrimary":false},{"overview":"Cho Soran conduce un'esistenza da studente qualunque, almeno finché non si trova intrappolato in un terribile incidente avvenuto in un paesino. Nell'addentrarsi in un cimitero, Cho viene assalito dagli zombie, ma all'improvviso appare anche una misteriosa ragazza che gli mette un coltello tra le mani per consentirgli di uccidere i nemici, ma che poi scompare nel nulla. Lo strano incontro è destinato a cambiare drasticamente il destino del ragazzo.","language":"ita","IsPrimary":false},{"overview":"隨著爺爺的屍體被盜，神秘少女馮寶寶的造訪，少年張楚嵐的平靜校園生活被打破。急於解開爺爺和自身秘密的張楚嵐和沒有任何記憶「不死少女」馮寶寶開啟了「異人」之旅……","language":"zhtw","IsPrimary":false},{"overview":"Suatu hari, dalam perjalanan untuk mengunjungi makam kakeknya, Zhang Chulan diserang oleh zombie di kuburan. Di tengah situasi itu, dia diselamatkan oleh seorang gadis misterius, yang menggunakan pisau dapur untuk membunuh musuh. Gadis itu memberi tahu Chulan, yang merasa lega, untuk menghadapi kesulitannya secara langsung dan pergi. Namun, Chulan kemudian melihat gadis itu lagi di universitasnya. Sejak saat itu, takdir Zhang Chulan mulai bergerak. Akan ada orang asing dengan kekuatan khusus yang muncul satu per satu, dengan pertempuran yang melibatkan kemampuan itu. Setiap episode akan membawa misteri baru terungkap.","language":"ind","IsPrimary":false}],"aliases":"[Yi Ren Zhi Xia,一人之下 THE OUTCAST,The Outcast,King of the Weirdo,Weirdo,The Weirdo,Under One Person,Hitori no Shita,The Outcast (2016)]"},"tags":[{"id":184,"tag":31,"tagName":"Geographic Location","name":"Asia"},{"id":157,"tag":9,"tagName":"Relationship Types","name":"Friends"},{"id":181,"tag":11,"tagName":"Setting","name":"Alternate Reality"},{"id":185,"tag":11,"tagName":"Setting","name":"Big City"},{"id":550,"tag":11,"tagName":"Setting","name":"Castle / Palace"},{"id":497,"tag":11,"tagName":"Setting","name":"College / University"},{"id":554,"tag":11,"tagName":"Setting","name":"Mountain"},{"id":556,"tag":11,"tagName":"Setting","name":"Wilderness"},{"id":1,"tag":1,"tagName":"Sub-Genre","name":"Adaptation"},{"id":63,"tag":3,"tagName":"TV Type or Format","name":"Story-based Drama","helpText":"Drama series where you must watch all episodes in order. Ex: Game of Thrones, The Walking Dead, Killing Eve"},{"id":80,"tag":3,"tagName":"TV Type or Format","name":"Story-based Web Series","helpText":"Short-form series where you must watch all episodes in order.  \r\nThey are not streaming shows on platforms like Netflix, Prime Video, or Disney+. Ex: Dr. Horrible's Sing-Along Blog "}],"contentRatings":[{"id":247,"name":"TV-MA","country":"usa","description":"Not suitable for children and teens under 17","contentType":"","order":0}],"seasonTypes":[{"id":1,"name":"Aired Order","type":"official"},{"id":2,"name":"DVD Order","type":"dvd"},{"id":3,"name":"Absolute Order","type":"absolute"}]}
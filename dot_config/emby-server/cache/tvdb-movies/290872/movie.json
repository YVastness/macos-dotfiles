ranslations":[{"overview":"Suomalainen opiskelija Yrjö von Grönhagen keräsi toisen maailmansodan kynnyksellä kansanperinnettä. Matka Pariisista Karjalaan katkesi Saksaan, kun Heinrich Himmler kiinnostui nuoresta opiskelijasta ja runonlaulannasta. von Grönhagen nimitettiin natsi-Saksan \"kansatieteellisen instituutin\" virkamieheksi, ja kalevalaisista lauluista haluttiin löytää juuret arjalaisen rodun vahvalle pohjoiselle historialle.","language":"fin","IsPrimary":true},{"overview":"\"Himmlers Kantele Player\" - about Finnish student, who decides to leave University of Sorbonne and walk from Paris to Helsinki in the spring of 1935. On his way, in Germany, he meets Heinrich Himmler, who is attracted by a traditional Finnish instrument, kantele. Himmler employs Yrjö as researcher to the Ahnenerbe institute to find the Aryan roots from the runic singing culture of Finnish Carelia.","language":"eng","IsPrimary":false}],"aliases":"[Himmlers kantelespelare,Minä, Himmler ja kantele]"},"companies":{"studio":[],"network":[],"production":[{"id":21650,"name":"Illume Oy","slug":"illume-oy","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[],"inspirations":[],"first_release":{"country":"fin","date":"2014-01-30","detail":"DocPoint Helsinki International Documentary Festival"}}
147/photo/63f415f0f0dd4.jpg","sort":5,"isFeatured":true,"url":"271147-virginia-madsen","peopleType":"Actor","personName":"Virginia Madsen","personImgURL":"https://artworks.thetvdb.com/banners/v4/actor/271147/photo/613c2966d286e.jpg"},{"id":12290446,"peopleId":351408,"movieId":"7560","type":1,"image":"","sort":4,"isFeatured":false,"url":"351408-audu-paden","peopleType":"Director","personName":"Audu Paden","personImgURL":""},{"id":12290447,"peopleId":295586,"movieId":"7560","type":2,"image":"","sort":4,"isFeatured":false,"url":"295586-bill-motz","peopleType":"Writer","personName":"Bill Motz","personImgURL":""},{"id":12290448,"peopleId":295587,"movieId":"7560","type":2,"image":"","sort":4,"isFeatured":false,"url":"295587-bob-roth","peopleType":"Writer","personName":"Bob Roth","personImgURL":""}],"budget":"0.00","boxOffice":"0.00","originalCountry":"usa","originalLanguage":"eng","lists":[{"id":67,"name":"Stuart Little","url":"1067","isOfficial":false,"nameTranslations":["eng"],"aliases":[],"score":831716,"image":"","imageIsFallback":false},{"id":6174,"name":"Stuart Little Franchise","overview":"A series of films following the adventures of an anthropomorphic mouse named Stuart who is adopted by an American couple as a brother to their little kid George.","url":"stuart-little","isOfficial":true,"nameTranslations":["eng","spa"],"overviewTranslations":"[eng]","aliases":[],"score":0,"image":"","imageIsFallback":false}],"translations":{"nameTranslations":[{"name":"Myšák Stuart Little 3","language":"ces","IsPrimary":false},{"name":"Stuart Little 3 - Naturen kalder","language":"dan","IsPrimary":false},{"name":"Stuart Little 3, en route pour l'aventure","language":"fra","IsPrimary":false},{"name":"Stuart Little 3: Aventura en el bosque","language":"spa","IsPrimary":false},{"name":"Stuart Little 3 - Ruf der Wildnis","language":"deu","IsPrimary":false},{"name":"スチュアート・リトル3 森の仲間と大冒険","language":"jpn","IsPrimary":false},{"name":"סטיוארט ליטל 3","language":"heb","IsPrimary":false},{"name":"Stuart Malutki 3 : Trochę natury","tagline":"Stuart już nie jest wcale taki Malutki!","language":"pol","IsPrimary":false},{"name":"Стюарт Литтл 3: Зов природы","language":"rus","IsPrimary":false},{"name":"Stuart Little 3 - Un topolino nella foresta","language":"ita","IsPrimary":false},{"name":"Stuart Little 3","language":"fin","IsPrimary":false},{"name":"Küçük Kardeşim 3","language":"tur","IsPrimary":false},{"name":"Stuart Little, kisegér 3: A vadon hívása","language":"hun","IsPrimary":false},{"name":"O Pequeno Stuart Little 3","language":"por","IsPrimary":false},{"name":"Stuart Little 3: Naturen Kallar","language":"swe","IsPrimary":false},{"name":"Stuart Little 3: Call of the Wild","language":"eng","IsPrimary":true},{"name":"O Pequeno Stuart Little 3","language":"pt","IsPrimary":false}],"overviewTranslations":[{"overview":"La souris Stuart et son frère George se rendent dans un camp de scout pour les vacances. Sur place se déroulent des activités mettant le courage à l'épreuve pendant lesquelles Stuart n'a que très peu l'occasion de s'illustrer sous son meilleur jour. Mais quand le chat Snowbell est enlevé par une créature tapie dans la forêt, la souris a l'opportunité de prouver son audace.","language":"fra","IsPrimary":false},{"overview":"En esta ocasión, los Little se van de acampada cerca del lago Garland. Sólo hay algo para lo que no están preparados: para la enorme bestia que vive en el bosque... Mientras Stuart aprende las técnicas básicas de supervivencia con Reeko, una simpática mofeta, el miedoso Bola de Nieve utiliza al gato callejero Monty para que le proteja...","language":"spa","IsPrimary":false},{"overview":"Rodzina Malutkich przemierza daleką drogę w tym ekscytującym animowanym filmie przygodowym. Podczas pobytu na kempingu daleko od Nowego Jorku Stuart i George przyłączają się do skautów, aby przejść kurs szkoły przetrwania. George zaprzyjaźnia się z uroczą skautką Brooke, Stuart natomiast najbardziej pożyteczne lekcje otrzymuje od pozbawionego przyjaciół skunksa o imieniu Reeko. W tym czasie Śnieżek wykorzystuje pasażera na gapę - kota przybłędę Muńka, by chronić go przed domniemaną bestią z lasu, jako że pozostała część rodziny cieszy się beztroskim wypoczynkiem, zapominając o całym świecie.","tagline":"Stuart już nie jest wcale taki Malutki!","language":"pol","IsPrimary":false},{"overview":"Веселая поездка семьи за город тоже может стать настоящим приключением… Собирайтесь в дорогу с дружной семьей Литтлов. В этой захватывающей истории семейка Литтлов отправляется в самое увлекательное путешествие. Стюарт вновь готов к приключениям и постигает уроки выживания в дикой природе у бравого скунса Рико.\r\n\r\nСнежок, привыкший к уютному дому, напуган и поэтому его сопровождает телохранитель — смышленый уличный кот Монти. Но, пустившись в поход Литтлы не были готовы к встрече с неизвестным хищником, обитающим в тех местах.","language":"rus","IsPrimary":false},{"overview":"La famiglia Little va in vacanza al lago quando misteriosamente il gatto di casa, Fiocco di Neve, scompare.","language":"ita","IsPrimary":false},{"overview":"Faz as malas e agarra a tua tenda de campismo, está na hora de embarcares com O PEQUENO STUART LITTLE 3, numa grande aventura no bosque!\r\n\r\nNeste excitante filme de animação, os Little mergulham na vida selvagem ao decidir acampar longe da cidade. Só há um detalhe para o qual não estão preparados: a enorme e malvada fera que vive no bosque.\r\n\r\nEnquanto Stuart aprende as aptidões básicas de sobrevivência com a destemida doninha Reeko, o medroso Snowbell prefere proteger-se com o expedito gato vadio Monty. A melhor aventura de Stuart!","language":"por","IsPrimary":false},{"overview":"With school out for the summer, The Littles vacation in a cabin by the lake. But when Snowbell is captured by a mean-spirited creature, The Beast, it's up to Stuart and a skunk named Reeko to rescue him and a few other friends.","language":"eng","IsPrimary":true},{"overview":"Stuart e a família Little saem de férias para uma cabana no lago. No entanto, Snowbell desaparece, e o ratinho suspeita de que seu amigo tenha sido sequestrado por um furioso animal da floresta. Então, Stuart pede a ajuda de um amigável gambá para resgatar seu companheiro felino.\r\n","language":"pt","IsPrimary":false}]},"companies":{"studio":[],"network":[],"production":[{"id":27178,"name":"Mainframe Entertainment","slug":"mainframe-entertainment","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":[],"special_effects":[]},"production_countries":[{"id":182008,"country":"usa","name":"United States of America"}],"inspirations":[],"spoken_languages":"[eng]","first_release":{"country":"global","date":"2005-07-14"}}
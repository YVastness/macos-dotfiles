8560,"name":"The Rock","peopleId":255089,"movieId":"214723","type":3,"image":"","sort":17,"isFeatured":true,"url":"255089-dwayne-johnson","peopleType":"Actor","personName":"Dwayne Johnson","personImgURL":"https://artworks.thetvdb.com/banners/person/255089/primary.jpg"},{"id":67028561,"name":"Dutch Mantell","peopleId":8189045,"movieId":"214723","type":3,"image":"","sort":18,"isFeatured":true,"url":"8189045-dutch-mantell","peopleType":"Actor","personName":"Wayne Keown","personImgURL":"https://artworks.thetvdb.com/banners/person/8189045/5fd0f7de56fbe.jpg"},{"id":67028562,"peopleId":9095707,"movieId":"214723","type":1,"image":"","sort":1,"isFeatured":true,"url":"9095707-kevin-dunn","peopleType":"Director","personName":"Kevin Dunn","personImgURL":""}],"originalCountry":"usa","originalLanguage":"eng","lists":[],"translations":{"nameTranslations":[{"name":"WWE: The Legacy of Stone Cold Steve Austin","language":"eng","IsPrimary":true},{"name":"WWE: The Legacy of Stone Cold Steve Austin","language":"zho","IsPrimary":false},{"name":"WWE: The Legacy of Stone Cold Steve Austin","language":"deu","IsPrimary":false}],"overviewTranslations":[{"overview":"He’s one of the most accomplished Superstars in the history of sports-entertainment, with a resume that includes six WWE Championship reigns, three Royal Rumble victories, a King of the Ring Championship, and an unprecedented run of raising hell throughout WWE. The Legacy of Stone Cold Steve Austin gives fans young and old the opportunity to relive the greatest matches and moments from the career of one of WWE’s most popular, and controversial, personalities.","language":"eng","IsPrimary":true},{"overview":"“德州响尾蛇”Stone Cold Steve Austin（“冷石”斯蒂文•奥斯汀）是职业摔角中的一道独特风景。早年周旋于WCW和ECW，虽然实力强悍，成绩卓著，却因机缘而苦无出头之日。来到WWF后，恰逢整个摔角界风格巨变，正派人物不再受人关注，而偏偏是Stone Cold这样的坏小子却越来越受大众欢迎。从最初与Bret Hart的对决，到1998年Wrestlemania上和Shawn Michaels那场经典世纪之战，当然还有和公司帮一连串精彩刺激的抗争，都在摔角迷心中留下难以磨灭的记忆。","language":"zho","IsPrimary":false},{"overview":"Er ist einer der erfolgreichsten Superstars in der Geschichte der Sportunterhaltung. Sein Lebenslauf umfasst sechs WWE-Championtitel, drei Royal Rumble-Siege, eine King of the Ring-Meisterschaft und einen beispiellosen Lauf der Hölle in der gesamten WWE. Das Vermächtnis von Stone Cold Steve Austin bietet jungen und alten Fans die Möglichkeit, die größten Matches und Momente aus der Karriere einer der beliebtesten und umstrittensten Persönlichkeiten der WWE noch einmal zu erleben.","language":"deu","IsPrimary":false}],"aliases":"[The Legacy of Stone Cold Steve Austin]"},"companies":{"studio":[],"network":[],"production":[{"id":46684,"name":"World Wrestling Entertainment","slug":"world-wrestling-entertainment-wwe","country":"usa","primaryCompanyType":3,"companyType":{"companyTypeId":3,"companyTypeName":"Production Company"},"parentCompany":{"relation":{}}}],"distributor":["{id:46684,name:World Wrestling Entertainment,slug:world-wrestling-entertainment-wwe,nameTranslations:null,overviewTranslations:null,aliases:null,country:usa,primaryCompanyType:3,activeDate:null,inactiveDate:null,companyType:{companyTypeId:4,companyTypeName:Distributor},parentCompany:{id:null,name:null,relation:{id:null,typeName:null}},tagOptions:null}"],"special_effects":[]},"production_countries":[],"inspirations":[],"first_release":{"country":"usa","date":"2008-02-12","detail":"DVD premiere"}}
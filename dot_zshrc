export PATH="/opt/homebrew/bin:$PATH"
# M1/M2/M3 芯片 (Intel 用户去掉最后的 /arm64)
export HOMEBREW_BOTTLE_DOMAIN=https://mirrors.tuna.tsinghua.edu.cn/homebrew-bottles/arm64
# 同时也设置 Git 克隆的加速环境变量 (关键！)
export HOMEBREW_GIT_URL=https://mirrors.tuna.tsinghua.edu.cn/git/homebrew

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/yinhaoyu/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions

alias ls='eza --icons'
alias l="ls -l"
alias ll='ls -al'
alias la='ls -a'
alias lt='ls --tree'
alias ld='lazydocker'
alias lg='lazygit'
alias ya='yazi'
alias ch='chezmoi'
alias cat='bat'
alias vi='nvim'
alias cd='z'

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
